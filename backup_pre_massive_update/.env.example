# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_BOT_TOKEN: The private token used to authenticate the DarkFlower Discord bot client.
DISCORD_BOT_TOKEN=""

# DISCORD_CLIENT_ID: The Discord Application client ID used to generate safe invite links.
DISCORD_CLIENT_ID=""

# DISCORD_CLIENT_SECRET: The Discord Application Client Secret used to exchange authorization codes.
DISCORD_CLIENT_SECRET=""

# DISCORD_SUPPORT_SERVER_INVITE: The direct link to your official Discord support server.
DISCORD_SUPPORT_SERVER_INVITE=""

# DISCORD_SUPPORT_SERVER_ID: The Discord Server ID (Guild ID) of your support server to auto-join users.
DISCORD_SUPPORT_SERVER_ID=""

# YOUTUBE_COOKIE: YouTube authorization cookie string or Netscape format for music bot streaming.
YOUTUBE_COOKIE=""

